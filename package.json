{
    "name": "linkedin-frame-maker",
    "version": "1.0.0",
    "description": "LinkedIn Frame Maker",
    "scripts": {
        "start": "echo \"Use a static server like npx serve or python -m http.server\"",
        "start:tailwind": "cross-env NODE_ENV=development tailwindcss --postcss -i css/tailwind.css -o css/tailwind-build.css -w",
        "build:tailwind": "cross-env NODE_ENV=production tailwindcss --postcss -i css/tailwind.css -o css/tailwind-build.css --minify",
        "lint": "eslint js/**/*.js",
        "lint:fix": "eslint js/**/*.js --fix",
        "format": "prettier --write \"**/*.{js,html,css,json}\"",
        "prepare": "husky"
    },
    "author": "McCheng",
    "license": "MIT",
    "devDependencies": {
        "autoprefixer": "^10.5.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.2.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "postcss": "^8.5.14",
        "prettier": "^3.8.1",
        "tailwindcss": "^3.4.19"
    }
}
